rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function isAdmin() {
      return signedIn() && request.auth.token.admin == true;
    }

    match /volunteers/{uid} {
      // A volunteer can create only their own pending volunteer profile.
      allow create: if isOwner(uid)
        && request.resource.data.keys().hasOnly([
          'uid', 'name', 'email', 'language', 'role',
          'approvalStatus', 'createdAt'
        ])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.role == 'volunteer'
        && request.resource.data.approvalStatus == 'pending';

      // Volunteers can read their own profile. Admins can read all profiles.
      allow read: if isOwner(uid) || isAdmin();

      // Volunteers cannot approve themselves or change their role.
      // Profile editing rules will be expanded in a later stage.
      allow update, delete: if isAdmin();
    }

    // Other collections remain closed until their specific rules are implemented.
    match /{document=**} {
      allow read, write: if isAdmin();
    }
  }
}
